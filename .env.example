# 链 RPC（Sepolia 可用下列无需 Key 的公共节点，Infura 需填 https://sepolia.infura.io/v3/你的项目ID）
ETH_RPC_URL=https://ethereum-sepolia.publicnode.com
CHAIN_ID=11155111

# 本地 MetaMask 账户地址（与下方私钥对应，用于校验联动）
WALLET_ADDRESS=0xb1D0Ff0982D3b700eBE0b1861be6e6514e1f6164

# 测试账户私钥（从 MetaMask 导出该账户私钥填入，实现与本地钱包联动）
TEST_PRIVATE_KEY=0x...

# 合约部署地址（部署成功后由脚本输出，可粘贴到此）
# CONTRACT_ADDRESS=0x...

# 钱包 UI 测试：pynpress 每次用助记词导入 MetaMask，步骤可复现
# WALLET_EXTENSION_PATH=/path/to/metamask/unpacked  # 不填则用 Chrome 默认扩展路径
# METAMASK_EXTENSION_ID=nkbihfbeogaeaoehlefnkodbefgpgknn  # 可选

# 助记词（必填）：用于 pynpress 导入钱包，每次运行都会执行导入流程
METAMASK_SEED_PHRASE=only year autumn bike cliff eagle have valid expire charge body guitar
# 或使用 MNEMONIC=...

# MetaMask 解锁密码（pynpress 导入时设置，后续解锁用）
METAMASK_PASSWORD=TestPassword123!

# 可选：API 基地址
# API_BASE_URL=https://api.example.com
